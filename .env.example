# Create and paste your [Last.fm API](https://www.last.fm/api/intro) details and connect music streaming services like Spotify so that the "Now Playing" feature...
LASTFM_USER=
LASTFM_KEY=

# [YouTube Data API v3](https://developers.google.com/youtube/v3) key (server-side only, search.list + videos.list)
YOUTUBE_API_KEY=
DEFAULT_PORT=3000

# Discord user ID for avatar (right-click user in Discord > Copy User ID)
DISCORD_USER_ID=

# Neon Postgres connection string (pooled) from Vercel Storage tab
DATABASE_URL=

# Random hex string for hashing visitor IPs (openssl rand -hex 32)
VISITOR_SALT=

# Only you know this. It is what /broadcast sends to start a transmission, so a
# stranger cannot put their own video on this site (openssl rand -hex 32)
BROADCAST_KEY=

# How many people can watch at the same time before new viewers are turned away
STREAM_VIEWER_CAP=5

# Metered.ca TURN relay so viewers behind strict NAT/firewall (often Windows)
# still connect. TURN_URLS is a comma-separated list of stun:/turn:/turns: URLs
TURN_URLS=
TURN_USER=
TURN_PASS=
